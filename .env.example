# Copy to .env for local runs. Every value is optional.

PORT=3001
# Postgres connection string. Leave empty to use the built-in embedded database (stored in DATA_DIR).
DATABASE_URL=
DATA_DIR=./.data
# Signs session cookies. Generated and stored automatically if empty.
SESSION_SECRET=

# Access control
OFFICE_PASSCODE=          # people must type this to enter (empty = anyone with the link)
ADMIN_CODE=               # typing this on the join screen makes you an admin (empty = first person in is admin)
ALLOWED_EMAIL_DOMAINS=    # e.g. rspsupply.com (empty = any email / no email)

# WebRTC. STUN finds public addresses; TURN relays media when firewalls block direct connections.
STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
TURN_URLS=                # e.g. turn:turn.example.com:3478,turns:turn.example.com:5349
TURN_USERNAME=
TURN_CREDENTIAL=
TURN_SECRET=              # coturn "use-auth-secret" value; mints short-lived per-user credentials instead

# Serve HTTPS with a self-signed certificate (to test on other computers on your LAN without a proxy)
HTTPS=false
